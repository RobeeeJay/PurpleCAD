{
  "name": "PurpleCAD",
  "description": "Full colour theme derived from the PurpleCAD icon palette",
  "foundation": {
    "bg":             { "hex": "#1A0D3B", "usage": "Viewport / canvas background" },
    "surface":        { "hex": "#26215C", "usage": "Panels, toolbars, sidebars" },
    "border":         { "hex": "#3C3489", "usage": "Panel edges, dividers" },
    "textPrimary":    { "hex": "#EEEDFE", "usage": "Labels, values, headings" },
    "textSecondary":  { "hex": "#AFA9EC", "usage": "Hints, muted labels" }
  },
  "sketchPlane": {
    "fill":   { "hex": "#6C3FD4", "alpha": 0.12, "usage": "Translucent plane surface" },
    "border": { "hex": "#6C3FD4", "alpha": 1.00, "usage": "Plane outline edge" },
    "normal": { "hex": "#6C3FD4", "alpha": 1.00, "usage": "Normal axis arrow" }
  },
  "sketchLines": {
    "active":        { "hex": "#7F77DD", "usage": "Active / default sketch line" },
    "node":          { "hex": "#D4A33F", "usage": "Vertex / endpoint node" },
    "selected":      { "hex": "#EEEDFE", "usage": "Selected sketch entity" },
    "offset":        { "hex": "#534AB7", "usage": "Offset line (dashed)" },
    "construction":  { "hex": "#3C3489", "usage": "Construction / centre line (dash-dot)" },
    "underconstrained": { "hex": "#AFA9EC", "usage": "Under-constrained geometry" },
    "fullyconstrained": { "hex": "#7F77DD", "usage": "Fully constrained geometry" }
  },
  "rulers": {
    "bg":     { "hex": "#26215C", "usage": "Ruler background" },
    "tick":   { "hex": "#D4A33F", "usage": "Major and minor tick marks" },
    "label":  { "hex": "#D4A33F", "alpha": 0.75, "usage": "Ruler numeric labels" },
    "cursor": { "hex": "#6C3FD4", "usage": "Live cursor position marker" },
    "border": { "hex": "#6C3FD4", "alpha": 0.45, "usage": "Ruler/viewport boundary" }
  },
  "grid": {
    "major":  { "hex": "#D4A33F", "alpha": 0.22, "usage": "Major grid lines" },
    "minor":  { "hex": "#D4A33F", "alpha": 0.10, "usage": "Minor grid lines" },
    "node":   { "hex": "#6C3FD4", "usage": "Grid intersection dots" },
    "origin": { "hex": "#D4A33F", "alpha": 0.45, "usage": "World origin X/Y/Z axes" }
  },
  "dimensions": {
    "line":       { "hex": "#6C3FD4", "usage": "Dimension measurement line + arrowheads" },
    "extension":  { "hex": "#C4C2B8", "usage": "Extension / projection lines" },
    "value":      { "hex": "#D4A33F", "usage": "Dimension value label" },
    "driven":     { "hex": "#BA7517", "usage": "Driven / reference dimension" }
  },
  "constraints": {
    "marker":        { "hex": "#D4A33F", "usage": "Constraint tick / symbol" },
    "label":         { "hex": "#EF9F27", "usage": "Constraint type label (⊥ ‖ etc)" },
    "overconstrained": { "hex": "#E24B4A", "usage": "Conflicting / redundant constraint" },
    "underconstrained": { "hex": "#AFA9EC", "usage": "Geometry with remaining DOF" },
    "solved":        { "hex": "#7F77DD", "usage": "Fully defined sketch" }
  }
}
