<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged with the keys Xcode generates (GENERATE_INFOPLIST_FILE): the .pcad
     document type, which the generated plist has no build settings for. -->
<plist version="1.0">
<dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.robeesworld.purplecad.document</string>
			<key>UTTypeDescription</key>
			<string>PurpleCAD Document</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pcad</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PurpleCAD Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.robeesworld.purplecad.document</string>
			</array>
		</dict>
	</array>
	<!-- A document is copied in and opened as a new project, as the desktop's
	     Open does; the app never edits the file where it lies. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
</dict>
</plist>
