{
  "name": "PurpleCAD",
  "version": "0.3.0",
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "purplecad-mcp": "mcp/purplecad-mcp.mjs"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"vite --port 3000\" \"npm run addon:build && npm run sqlite:rebuild && wait-on tcp:127.0.0.1:3000 && unset ELECTRON_RUN_AS_NODE; ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "mcp": "node mcp/purplecad-mcp.mjs",
    "build": "vite build",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\"",
    "test": "./scripts/with-display.sh vitest run",
    "test:watch": "./scripts/with-display.sh vitest",
    "e2e:build": "npm run addon:build && VITE_E2E=1 vite build",
    "test:e2e": "npm run e2e:build && ./scripts/with-display.sh playwright test",
    "test:e2e:run": "./scripts/with-display.sh playwright test",
    "electron:start": "npm run addon:build && npm run sqlite:rebuild && vite build && unset ELECTRON_RUN_AS_NODE; electron .",
    "addon:build": "npm --prefix native/occ-addon run build",
    "addon:test": "npm --prefix native/occ-addon test",
    "sqlite:rebuild": "electron-rebuild -w better-sqlite3",
    "electron:build": "npm run sqlite:rebuild && vite build && electron-builder --config.mac.target=dmg",
    "app": "./scripts/open-app.sh",
    "dist": "npm run addon:build && vite build && electron-builder --publish never",
    "dist:mac": "npm run addon:build && vite build && electron-builder --mac --publish never",
    "dist:mac-arm64": "npm run addon:build && vite build && electron-builder --mac --arm64 --publish never",
    "dist:mac-x64": "npm run addon:build && vite build && electron-builder --mac --x64 --publish never",
    "dist:win": "npm run addon:build && vite build && electron-builder --win --publish never",
    "dist:linux": "npm run addon:build && vite build && electron-builder --linux --publish never",
    "dist:all": "npm run addon:build && vite build && electron-builder --mac --win --linux --publish never",
    "test:coverage": "./scripts/with-display.sh vitest run --coverage",
    "e2e:image": "podman build -f Containerfile.e2e -t purple-cad-e2e .",
    "test:e2e:podman": "podman run --rm --name purple-cad-e2e-run -v \"$PWD/test-results:/app/test-results\" purple-cad-e2e",
    "e2e:podman:stop": "podman rm -f purple-cad-e2e-run >/dev/null 2>&1; echo 'still running (empty = clean):'; podman ps --filter ancestor=purple-cad-e2e --format '{{.Names}} {{.Status}}'"
  },
  "build": {
    "appId": "com.purplecad",
    "productName": "PurpleCAD",
    "icon": "app-icons/padded/icon-1024.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      {
        "from": "native/occ-addon/build/Release",
        "to": "native/occ-addon/build/Release",
        "filter": [
          "occ_addon.node"
        ]
      },
      {
        "from": "app-icons/padded",
        "to": "app-icons/padded",
        "filter": [
          "icon-512.png"
        ]
      }
    ],
    "asarUnpack": [
      "native/occ-addon/build/Release/occ_addon.node"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics"
    },
    "afterPack": "scripts/afterPack.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "^12.11.1",
    "decimal.js": "^10.6.0",
    "opentype.js": "^1.3.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "three-bvh-csg": "^0.0.18",
    "three-gpu-pathtracer": "^0.0.24",
    "three-mesh-bvh": "^0.9.10",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-reloader": "^1.2.3",
    "prettier": "^3.9.5",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  }
}
