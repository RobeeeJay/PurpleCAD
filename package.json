{
  "name": "untitled-cad",
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "unset ELECTRON_RUN_AS_NODE; electron .",
    "electron:dev": "concurrently -k -n vite,electron -c blue,magenta \"vite --port 3000\" \"wait-on http://localhost:3000 && unset ELECTRON_RUN_AS_NODE; ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "electron:start": "vite build && unset ELECTRON_RUN_AS_NODE; electron .",
    "addon:build": "npm --prefix native/occ-addon run build",
    "addon:test": "npm --prefix native/occ-addon test",
    "electron:build": "vite build && electron-builder --config.mac.target=dmg"
  },
  "build": {
    "appId": "com.untitled-cad",
    "productName": "untitled-cad",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      {
        "from": "native/occ-addon/build/Release",
        "to": "native/occ-addon/build/Release",
        "filter": ["occ_addon.node"]
      }
    ],
    "asarUnpack": [
      "native/occ-addon/build/Release/occ_addon.node"
    ],
    "mac": {
      "target": [{"target": "dmg", "arch": ["arm64"]}],
      "category": "public.app-category.productivity"
    },
    "afterPack": "scripts/afterPack.cjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.157.0",
    "three-bvh-csg": "^0.0.14",
    "three-mesh-bvh": "^0.6.8",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.2.1",
    "electron": "^28.3.3",
    "electron-builder": "^26.8.1",
    "prettier": "^3.8.3",
    "vite": "^4.5.14",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.10"
  }
}
