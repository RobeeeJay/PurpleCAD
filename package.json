{
  "name": "PurpleCAD",
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"vite --port 3000\" \"npm run addon:build && wait-on tcp:127.0.0.1:3000 && unset ELECTRON_RUN_AS_NODE; ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "build": "vite build",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:build": "npm run addon:build && VITE_E2E=1 vite build",
    "test:e2e": "npm run e2e:build && playwright test",
    "test:e2e:run": "playwright test",
    "electron:start": "npm run addon:build && vite build && unset ELECTRON_RUN_AS_NODE; electron .",
    "addon:build": "npm --prefix native/occ-addon run build",
    "addon:test": "npm --prefix native/occ-addon test",
    "electron:build": "vite build && electron-builder --config.mac.target=dmg"
  },
  "build": {
    "appId": "com.purplecad",
    "productName": "PurpleCAD",
    "icon": "app-icons/padded/icon-1024.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      {
        "from": "native/occ-addon/build/Release",
        "to": "native/occ-addon/build/Release",
        "filter": [
          "occ_addon.node"
        ]
      }
    ],
    "asarUnpack": [
      "native/occ-addon/build/Release/occ_addon.node"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "afterPack": "scripts/afterPack.cjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.180.0",
    "three-gpu-pathtracer": "^0.0.24",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.2.1",
    "electron": "^28.3.3",
    "electron-builder": "^26.8.1",
    "electron-reloader": "^1.2.3",
    "prettier": "^3.8.3",
    "vite": "^4.5.14",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.10"
  }
}
